<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- LEFT PANEL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="38"
        android:orientation="vertical"
        android:gravity="start"
        android:paddingEnd="14dp">

        <!-- City with pin -->
        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 İZMİR"
            android:textColor="#D4AF37"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- "SONRAKİ" -->
        <TextView
            android:id="@+id/widget_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SONRAKİ"
            android:textColor="#60FFFFFF"
            android:textSize="9sp"
            android:layout_marginBottom="0dp" />

        <!-- Next Prayer Name -->
        <TextView
            android:id="@+id/widget_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="İmsak"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="0dp" />

        <!-- Next Prayer Time -->
        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03:52"
            android:textColor="#88FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <!-- Countdown Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_countdown_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <Chronometer
                android:id="@+id/widget_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D4AF37"
                android:textSize="14sp"
                android:textStyle="bold"
                android:format="⏱ %s" />

        </LinearLayout>

    </LinearLayout>

    <!-- DIVIDER -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_divider"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="divider" />

    <!-- RIGHT PANEL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="50"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:gravity="center_vertical">

        <!-- İmsak -->
        <LinearLayout
            android:id="@+id/row_imsak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_prayer_normal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/label_imsak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌙  İmsak"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/time_imsak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Öğle -->
        <LinearLayout
            android:id="@+id/row_ogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_prayer_normal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/label_ogle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☀️  Öğle"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/time_ogle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- İkindi -->
        <LinearLayout
            android:id="@+id/row_ikindi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_prayer_normal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/label_ikindi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⛅  İkindi"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/time_ikindi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Akşam -->
        <LinearLayout
            android:id="@+id/row_aksam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_prayer_normal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/label_aksam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌆  Akşam"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/time_aksam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Yatsı -->
        <LinearLayout
            android:id="@+id/row_yatsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_prayer_normal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/label_yatsi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✨  Yatsı"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/time_yatsi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
