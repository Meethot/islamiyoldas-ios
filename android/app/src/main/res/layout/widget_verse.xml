<?xml version="1.0" encoding="utf-8"?>
<!-- Günün Ayeti / Saatlik Ayet / Günün Motivasyonu ortak medium layout
     (iOS VerseMediumWidgetView tasarımının birebir karşılığı).
     Başlık metni ve ikonu provider tarafından runtime'da set edilir. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_verse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_islamic">

    <!-- Geometrik desen + mihrap kemeri + ışık küreleri (kod ile çizilir) -->
    <ImageView
        android:id="@+id/widget_verse_decor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- Header: altın kutulu ikon + başlık -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_icon_bg">

                <ImageView
                    android:id="@+id/widget_verse_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_sparkle"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_verse_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="GÜNÜN AYETİ"
                android:textColor="#D4AF37"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.22"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Üst süsleme: çizgi • çizgi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:src="@drawable/widget_ornament_line"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <ImageView
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/widget_dot_gold"
                android:importantForAccessibility="no" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:src="@drawable/widget_ornament_line"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Ayet metni (serif, ortalanmış, otomatik boyut) -->
        <TextView
            android:id="@+id/widget_verse_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="serif"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="14sp"
            android:lineSpacingExtra="3dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Alt bölücü: çizgi • çizgi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:src="@drawable/widget_divider_gold"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <ImageView
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/widget_dot_gold"
                android:importantForAccessibility="no" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:src="@drawable/widget_divider_gold"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Kaynak -->
        <TextView
            android:id="@+id/widget_verse_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="#80D4AF37"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
